// -------------------- FLUXO CLIENTE --------------------

### 1. Criar conta
POST http://localhost:3000/auth/signup
Content-Type: application/json

{
  "email": "joao@gmail.com", 
  "senha": "123",
  "role": "USER",
  "nome": "João",
  "telefone": "61982825252"
}

### 2. Logar conta
POST http://localhost:3000/auth/signin
Content-Type: application/json

{
    "email": "joao@gmail.com", 
    "senha": "123"
}

### 3. Adicionar endereço
POST http://localhost:3000/endereco
Authorization: Bearer <TOKEN>
Content-Type: application/json

{
    "id_cliente": 1,
    "estado": "GO",
    "cidade": "Cidade Ocidental",
    "bairro": "Centro",
    "rua": "SQ15 Q15",
    "complemento": "CASA 15",
    "cep": "88888-000"
}

### 4. Visualizar produtos
GET http://localhost:3000/produto

### 5. Criar carrinho
POST http://localhost:3000/carrinho
Authorization: Bearer <TOKEN>
Content-Type: application/json

{ 
    "dataCriacao": "2025-06-19",
    "idCliente": 1
}

### 6. Adicionar itens ao carrinho
POST http://localhost:3000/itens-carrinho
Authorization: Bearer <TOKEN>
Content-Type: application/json

{ 
    "quantidade": 5,
    "idProduto": 1,
    "idCarrinho": 1
}

### 7. Criar pedido
POST http://localhost:3000/pedido
Authorization: Bearer <TOKEN>
Content-Type: application/json

{
    "id_carrinho": 1,
    "id_cliente": 1,
    "id_entregador": 1,
    "id_status": 1,
    "valor_total": 2.25,
    "data_pedido": "2025-06-19"
}

### 8. Adicionar pagamento
POST http://localhost:3000/pagamento
Authorization: Bearer <TOKEN>
Content-Type: application/json

{ 
    "id_status": 1,
    "id_pedido": 1,
    "metodo_pagamento": "pix",
    "valor": 2.25,
    "data_pagamento": "2025-06-19"
}

### 9. Visualizar pedido
GET http://localhost:3000/pedido/1
Authorization: Bearer <TOKEN>

###10. Cria um histórico de uma compra (era pra ser feito de forma automática)
POST http://localhost:3000/historico-compra
Content-Type: application/json

{
    "id_cliente": 1,
    "id_pedido": 1,
    "data_compra": "2025-06-19"
}

//  -------------------- CLIENTE ADICIONANDO AOS FAVORITOS --------------------

### 1. Adicionar um produto ao favorito
POST http://localhost:3000/favoritos
Authorization: Bearer <TOKEN>
Content-Type: application/json

{ 
    "id_produto": 1,
    "id_cliente": 1,
    "data_adicao": "2025-06-19"
}

### 2. Verificar os itens nos seus favoritos com base no seu id
GET http://localhost:3000/favoritos/1
Authorization: Bearer <TOKEN>


#### -------------------- FLUXO LOJA -------------------- ####

###1. Criar conta
POST http://localhost:3000/auth/signup
Content-Type: application/json

{
  "role": "MANAGER",
  "nome": "SuperTenda",
  "endereco": "SMPW 1 CONJUNTO 1 LOTE 1",
  "email": "supertenda@gmail.com",
  "telefone":"61911223344",
  "senha":"123",
  "dados_bancarios":"00123456789"
}

###2. Logar conta
POST http://localhost:3000/auth/signin
Content-Type: application/json

{
  "email": "supertenda@gmail.com",
  "senha":"123"
}

###3. Ações da loja

###3.1 Visualizar dados da loja
GET http://localhost:3000/loja/1
Authorization: Bearer <TOKEN>
Content-Type: application/json

###3.2 Alterar dados da loja
PATCH http://localhost:3000/loja/1
Authorization: Bearer <TOKEN>
Content-Type: application/json

{
  "role": "MANAGER",
  "nome": "SuperTenda",
  "endereco": "SMPW 5 CONJUNTO 5 LOTE 5",
  "email": "supertenda@gmail.com",
  "telefone":"61911223344",
  "senha":"123",
  "dados_bancarios":"00122334455"
}

###4. Criar produto
POST http://localhost:3000/produto
Authorization: Bearer <TOKEN>
Content-Type: application/json

{
  "nome": "Banana",
  "descricao":"Fruta rica em potássil",
  "preco": 0.40,
  "quantidade": 100,
  "categoria":"Fruta tropical",
  "id_loja": 1
}

###4.1 Alterar informações de produto
PATCH http://localhost:3000/produto/1
Authorization: Bearer <TOKEN>
Content-Type: application/json

{
  "nome": "Banana",
  "descricao":"Fruta rica em potássil",
  "preco": 0.45,
  "quantidade": 60,
  "categoria":"Fruta tropical",
  "id_loja": 1
}

###4.2 Listar produto criado pelo id_produto
GET http://localhost:3000/produto/1
Authorization: Bearer <TOKEN>

###4.3 Deletar produto
DELETE http://localhost:3000/produto/1
Authorization: Bearer <TOKEN>


//  -------------------- FLUXO ENTREGADOR --------------------

### 1. Criar conta
POST http://localhost:3000/auth/signup
Content-Type: application/json

{
  "email": "roberto@gmail.com", 
  "senha": "123",
  "role": "DELIVERY",
  "nome": "Roberto",
  "telefone": "61931314141",
   "cpf": "00122355963",
   "veiculo": "Motocicleta",
   "dados_bancarios": "01222222222"
}

### 2. Logar conta
POST http://localhost:3000/auth/signin
Content-Type: application/json

{
    "email": "roberto@gmail.com", 
    "senha": "123"
}

### 3. Listar pedidos por id_pedido
GET http://localhost:3000/pedido/1
Authorization: Bearer <TOKEN>


### Atualizar o status de um pedido para "entregue"
### id_status, 1 para pendente, 2 para entregue
PATCH http://localhost:3000/pedido/1
Authorization: Bearer <TOKEN>
Content-Type: application/json

{
    "id_status": 2
}
